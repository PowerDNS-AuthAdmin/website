# Reference nginx config for serving dist/ (nginx 1.25+).
# Replace the certificate paths and web root with your own. The copy on the production host
# is maintained by hand; keep this file in step with it when something changes.
#
# Notes
# - Security headers live at server level only. Caching uses `expires`, which does not
#   reset inherited add_header directives the way a location-level add_header would.
# - The page's own CSP is a <meta> tag generated by the build (it carries the hash of the
#   inline theme script). The header below only adds what a meta CSP can't express.
# - Every page is a directory with an index.html (/features/, /docs/installation/,
#   /docs/adr/0004-three-layer-architecture/, /search/ ...), so `try_files $uri $uri/`
#   covers new pages without a config change. Text files at the root (/robots.txt,
#   /llms.txt, /llms-full.txt, /sitemap.xml, the IndexNow key) are plain static files
#   served by `location /` with revalidation.
# - The pda-site user owns the web root: pull-site.timer (deploy/pull-site.*) runs as it and
#   copies the `site` branch in; nginx only needs read access. A by-hand `npm run deploy` from a
#   workstation rsyncs as root with DEPLOY_OWNER=pda-site:pda-site.

server {
    listen      80;
    listen      [::]:80;
    server_name powerdns-authadmin.org www.powerdns-authadmin.org;
    return 301 https://powerdns-authadmin.org$request_uri;
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name www.powerdns-authadmin.org;
    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;
    return 301 https://powerdns-authadmin.org$request_uri;
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name powerdns-authadmin.org;

    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout       1d;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_tickets       off;

    root  /var/www/powerdns-authadmin-website;
    index index.html;
    server_tokens     off;
    absolute_redirect off;            # /features -> /features/ without a scheme/port guess
    charset           utf-8;
    charset_types     text/plain text/css text/xml application/javascript application/xml application/json application/manifest+json;

    # Security headers (server level so every response gets them)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy   "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    # Compression for text assets (HTML is compressed by default). application/json covers
    # the search index, text/plain the llms.txt files.
    gzip            on;
    gzip_vary       on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types      text/css application/javascript text/javascript image/svg+xml application/xml text/xml
                    text/plain application/json application/manifest+json image/x-icon;

    error_page 404 /404.html;

    # /index.html and /features/index.html duplicate their directory URL. $request_uri is the
    # original request, so the index directive's internal redirect never loops.
    if ($request_uri ~ "^([^?]*/)index\.html(\?.*)?$") {
        return 301 $1$2;
    }

    # Footer status badges, fetched server-side and cached so visitors never contact the
    # badge services. deploy/nginx-badges.conf (generated) goes to snippets/pda-badges.conf,
    # deploy/nginx-badge-proxy.conf to snippets/pda-badge-proxy.conf, and the http block needs:
    #   proxy_cache_path /var/cache/nginx/pda-badges levels=1:2 keys_zone=pda_badges:1m max_size=20m inactive=7d use_temp_path=off;
    include snippets/pda-badges.conf;

    location / {
        try_files $uri $uri/ =404;
        expires -1;                   # HTML and root text files: always revalidate (ETag makes it cheap)
    }

    # Fingerprinted CSS, JS and search index: the file name changes whenever the content does.
    location ~ ^/assets/(css|js|search)/ {
        expires max;
        access_log off;
        try_files $uri =404;
    }

    # Social cards keep their name when regenerated, so a week is the longest a stale one lives.
    location /assets/og/ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # Fonts, screenshots, icons
    location /assets/ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~ ^/(favicon\.ico|favicon\.svg|apple-touch-icon\.png)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location = /site.webmanifest {
        default_type application/manifest+json;
        expires 1d;
        try_files $uri =404;
    }

    location = /404.html { internal; }
}
