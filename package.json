{
  "name": "powerdns-authadmin-website",
  "private": true,
  "description": "Source for powerdns-authadmin.org, the PowerDNS-AuthAdmin project website.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/badges-nginx.mjs --check && node scripts/check.mjs && npx --yes html-validate@9 \"dist/**/*.html\"",
    "check:base": "SITE_URL=http://127.0.0.1:8080/preview node scripts/build.mjs && node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "SITE_URL=http://127.0.0.1:8080 node scripts/build.mjs && node scripts/serve.mjs",
    "serve:base": "SITE_URL=http://127.0.0.1:8080/preview node scripts/build.mjs && node scripts/serve.mjs",
    "media": "node scripts/build-media.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "deploy": "sh scripts/deploy.sh",
    "badges:nginx": "node scripts/badges-nginx.mjs"
  }
}
