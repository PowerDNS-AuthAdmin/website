# Copy to .env.deploy (git-ignored) and fill in. Used by scripts/deploy.sh only.
# Anything set in the environment wins over this file, which is how the Deploy
# workflow runs the same script without a file: INDEXNOW=0 npm run deploy works too.
DEPLOY_HOST=user@your-server
DEPLOY_PATH=/var/www/powerdns-authadmin-website
# Owner applied on the server (needs root over SSH). Leave empty when the SSH user
# owns the web root, which is the normal setup and what CI assumes.
DEPLOY_OWNER=
# Ping IndexNow (Bing, Yandex, ...) after a successful deploy: 1 or 0
INDEXNOW=1
# 1 publishes the existing dist/ without building or checking it (CI sets this after
# running the build and checks itself). Leave at 0 for a local deploy.
SKIP_BUILD=0
