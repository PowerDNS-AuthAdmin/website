# Copy to .env.deploy (git-ignored) and fill in. Used by scripts/deploy.sh only.
DEPLOY_HOST=user@your-server
DEPLOY_PATH=/var/www/powerdns-authadmin-website
# Owner applied on the server (needs root over SSH); leave empty to skip.
DEPLOY_OWNER=www-data:www-data
# Ping IndexNow (Bing, Yandex, ...) after a successful deploy: 1 or 0
INDEXNOW=1
